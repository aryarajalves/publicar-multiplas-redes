# ==============================================================
# CONFIGURAÇÕES DO AMBIENTE - SOCIAL STREAM HUB
# ==============================================================

# PORTAS LOCAIS (HOST)
POSTGRES_PORT=5438
REDIS_PORT=6385
BACKEND_PORT=8005
FRONTEND_PORT=3005

# BANCO DE DADOS POSTGRESQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=social_publisher_db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@social-vault-postgres:5432/social_publisher_db

# FILA & REDIS
REDIS_URL=redis://social-broker-redis:6379/0

# MODO DE SIMULAÇÃO (true para testar localmente sem precisar de chaves das redes sociais)
SIMULATE_PUBLICATIONS=true

# DIRETÓRIO DE UPLOADS
UPLOAD_DIR=uploads

# INSTAGRAM (META GRAPH API - REELS)
# Obtenha em: https://developers.facebook.com/
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# YOUTUBE (DATA API v3 - SHORTS)
# Obtenha em: https://console.cloud.google.com/
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# TIKTOK (CONTENT POSTING API)
# Obtenha em: https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=seu_client_key_aqui
TIKTOK_CLIENT_SECRET=seu_client_secret_aqui
TIKTOK_ACCESS_TOKEN=
# URL de callback autorizada no painel do TikTok for Developers [OBRIGATÓRIO]
TIKTOK_REDIRECT_URI=http://localhost:8005/api/auth/tiktok/callback
# URL pública do Frontend para redirecionar após autorização OAuth [OBRIGATÓRIO]
FRONTEND_URL=http://localhost:3005

# OPENAI (TRANSCRIÇÃO WHISPER E GERAÇÃO DE LEGENDAS/TÍTULOS)
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ==============================================================
# CREDENCIAIS DO SUPER ADMIN (PRIMEIRO ACESSO DO SISTEMA)
# ==============================================================
# [OPCIONAL] Nome do Super Administrador criado no bootstrap do sistema
SUPER_ADMIN_NAME=Super Admin
# [OBRIGATÓRIO] E-mail do Super Administrador com acesso total ao projeto
SUPER_ADMIN_EMAIL=admin@multipost.com
# [OBRIGATÓRIO] Senha de login do Super Administrador para o primeiro acesso
SUPER_ADMIN_PASSWORD=admin123

# ==============================================================
# BREVO (SENDINBLUE) - API DE DISPARO DE E-MAIL TRANSACIONAL
# ==============================================================
# [OPCIONAL/OBRIGATÓRIO EM PROD] Chave de API v3 da conta Brevo para envio de códigos de validação OTP
# Obtenha em: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-seu_token_aqui

# [OPCIONAL] E-mail remetente autenticado e verificado no painel da Brevo
BREVO_SENDER_EMAIL=contato@multipost.com

# [OPCIONAL] Nome do remetente exibido nas caixas de entrada dos usuários
BREVO_SENDER_NAME=MultiPost



# ==============================================================
# BACKBLAZE B2 / S3 CLOUD STORAGE (BACKUP AUTOMÁTICO)
# ==============================================================
# [OPCIONAL/RECOMENDADO EM PROD] Identificador da chave de aplicação do Backblaze B2 (Key ID)
# Obtenha em: https://secure.backblaze.com/app_keys.htm
B2_APPLICATION_KEY_ID=005xxxxxxxxxxxxxxxxxx000001

# [OPCIONAL/RECOMENDADO EM PROD] Segredo da chave de aplicação (Application Key)
B2_APPLICATION_KEY=K005xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [OPCIONAL] Nome do Bucket criado no Backblaze B2 para receber os backups
B2_BUCKET_NAME=multipost-backups

# [OPCIONAL] Endpoint S3 compatível da sua região no Backblaze B2
B2_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com

# [OPCIONAL] Região do bucket Backblaze B2
B2_REGION_NAME=us-east-005
