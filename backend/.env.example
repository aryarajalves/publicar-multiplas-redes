# ==============================================================
# CONFIGURAÇÕES DO AMBIENTE - SOCIAL STREAM HUB
# ==============================================================

# BANCO DE DADOS POSTGRESQL (STRING DE CONEXÃO DIRETA)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@host.docker.internal:5432/social_publisher_db

# INSTAGRAM (META GRAPH API - REELS)
# Obtenha em: https://developers.facebook.com/
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# YOUTUBE (DATA API v3 - VÍDEOS E SHORTS)
# Obtenha em: https://console.cloud.google.com/
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# TIKTOK (CONTENT POSTING API)
# Obtenha em: https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=seu_client_key_aqui
TIKTOK_CLIENT_SECRET=seu_client_secret_aqui
TIKTOK_ACCESS_TOKEN=
TIKTOK_REDIRECT_URI=http://localhost:8005/api/auth/tiktok/callback
FRONTEND_URL=http://localhost:3005

# CREDENCIAIS DO SUPER ADMIN (PRIMEIRO ACESSO DO SISTEMA)
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@multipost.com
SUPER_ADMIN_PASSWORD=admin123

# BREVO (SENDINBLUE) - API DE DISPARO DE E-MAIL TRANSACIONAL COM CÓDIGOS OTP
# Obtenha em: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-seu_token_aqui
BREVO_SENDER_EMAIL=contato@multipost.com
BREVO_SENDER_NAME=MultiPost

# BACKBLAZE B2 / S3 CLOUD STORAGE (BACKUP AUTOMÁTICO E LINKS PÚBLICOS)
# Obtenha em: https://secure.backblazeb2.com/app_keys.htm
B2_APPLICATION_KEY_ID=005xxxxxxxxxxxxxxxxxx000001
B2_APPLICATION_KEY=K005xxxxxxxxxxxxxxxxxxxxxxxxxxxx
B2_BUCKET_NAME=multipost-backups
B2_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
B2_REGION_NAME=us-east-005
